# MindMap Server — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── SECURITY ────────────────────────────────────────────────────
# Generate a strong token: python3 -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=your-secret-token-here

# ── APIs ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ── DATABASE ──────────────────────────────────────────────────────
DB_PATH=mindmap.db

# ── PERFORMANCE ───────────────────────────────────────────────────
# Parallel transcript workers (increase carefully — YouTube rate limits)
MAX_WORKERS=3

# Seconds between YouTube requests per worker (don't go below 1.0)
RATE_DELAY=1.5

# ── LOGGING ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── TIER 4 UPGRADE (leave blank for Tier 2) ──────────────────────
# REDIS_URL=redis://localhost:6379/0
# WORKER_NODE_URL=http://vps2-internal-ip:8001
